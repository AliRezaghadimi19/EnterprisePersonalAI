# ==============================================================================
# Enterprise AI Assistant Platform - Environment Configuration
# ==============================================================================

# Application
APP_NAME="سامانه هوش مصنوعی سازمانی"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
FERNET_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=" # Base64 32-byte key for encrypting API Keys and AD bind credentials
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14

# Super Admin Initial Credentials
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="Enterprise@Admin123!"
SUPER_ADMIN_EMAIL="admin@enterprise.local"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="enterprise_ai"
POSTGRES_USER="ai_admin"
POSTGRES_PASSWORD="Secr3t_Db_P@ssw0rd"
DATABASE_URL="postgresql://ai_admin:Secr3t_Db_P@ssw0rd@localhost:5432/enterprise_ai"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="Secr3t_Red!s_P@ssw0rd"
REDIS_URL="redis://:Secr3t_Red!s_P@ssw0rd@localhost:6379/0"

# S3 / MinIO Object Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="Secr3t_M!n!o_P@ssw0rd"
S3_BUCKET_NAME="enterprise-ai-documents"

# Authentication Settings
AUTH_MODE="BOTH" # Options: AD_ONLY, LOCAL_ONLY, BOTH
AUTO_PROVISION_AD_USERS=true
DEFAULT_AD_ROLE="کاربر عادی"
DEFAULT_AD_GROUP="کاربران عمومی"

# AI Default Policy
DEFAULT_RESPONSE_POLICY="HYBRID" # Options: KNOWLEDGE_ONLY, HYBRID, FREE_AI
DEFAULT_AI_LANGUAGE="fa" # Persian as default
